{
  "expo": {
    "name": "RELEVA",
    "slug": "releva",
    "scheme": "releva",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c1717",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c1717"
    },
    "android": {
      "package": "org.releva.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f3d3e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "RECORD_AUDIO"],
      "blockedPermissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RELEVA usa tu ubicación para registrar dónde se releva cada punto y detectar si el vehículo está detenido."
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
